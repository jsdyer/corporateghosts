  "data_info": {
    "mode": "mixed",
    "detail": "Federal register snapshots, live BC OrgBook search and the published Nova Scotia co-operative list cover different jurisdictions.",
    "cadence": "Daily federal build",
    "probes": [
      {
        "label": "Federal snapshot",
        "url": "https://coolcode.ca/corporateghosts/data/manifest.json",
        "path": [
          "built"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "federal records"
        }
      },
      {
        "label": "Nova Scotia register",
        "url": "https://coolcode.ca/corporateghosts/ns-coops.json",
        "path": [
          "as_of"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "co-operatives"
        }
      }
    ]
  }
